# Optional internal backend only; existing Dockerfile/compose defaults are unchanged.
FROM quay.io/openbao/openbao@sha256:5046911075e137e154ce49ab051502f4ec7cf367d484ae4a4dce665d9b90561f AS upstream
FROM python:3.12-slim@sha256:9d3abd9fc11d06998ccdbdd93b4dd49b5ad7d67fcbbc11c016eb0eb2c2194891
COPY --from=upstream /usr/bin/bao /bin/bao
RUN echo "9c5f36287c673f386e1533e9c044169a248e4ee50dd54810fa766e95bd41b788  /bin/bao" | sha256sum -c -
COPY docs/openbao-LICENSE /usr/share/licenses/openbao/LICENSE
COPY docs/openbao-sbom.json.gz /usr/share/doc/openbao/sbom.json.gz
COPY docs/openbao-README.txt /usr/share/doc/openbao/README
COPY src/blockwart/cli/safe_backend.py /supervisor.py
ENTRYPOINT ["python", "/supervisor.py"]
