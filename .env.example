# Blockwart local configuration.
# Use placeholders and credential references only. Do not put secret values here.

BLOCKWART_ENV=dev
BLOCKWART_BUILD_REVISION=development
BLOCKWART_DATABASE_URL=sqlite:///./blockwart.sqlite3
BLOCKWART_SECRET_REFERENCE=local-dev-placeholder
BLOCKWART_SQLITE_BUSY_TIMEOUT_MS=5000
BLOCKWART_SQLITE_WAL_ENABLED=true

# Optional admin unlock. Leave unset for fail-closed read-only mode.
# Source the value from the protected runtime secret store; minimum 32 characters.
# BLOCKWART_ADMIN_TOKEN=
BLOCKWART_ADMIN_SESSION_TTL_SECONDS=3600
BLOCKWART_ADMIN_COOKIE_SECURE=false

# New identity-session foundation. This does not yet authorize catalog access.
BLOCKWART_AUTH_SESSION_TTL_SECONDS=3600
BLOCKWART_AUTH_LOGIN_CHALLENGE_TTL_SECONDS=600
BLOCKWART_AUTH_COOKIE_SECURE=false

# MCP service-account credentials belong in the runtime secret store.
# Prefer a protected token file; configure at most one source.
# BLOCKWART_API_TOKEN_FILE=/protected/runtime/blockwart-api-token
# BLOCKWART_API_TOKEN=
