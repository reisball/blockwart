# Invoked by the existing supervisor only when the active file reaches 10 MiB.
# Native OpenBao SIGHUP reopens the file after successful rotation.
# Delay compression until the previous descriptor has been closed.
/openbao/audit/audit.json {
    size 10M
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    create 0600
}
